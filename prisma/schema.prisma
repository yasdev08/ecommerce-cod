// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL") // Add your MongoDB connection string
}

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  clerkId    String   @unique // ID from Clerk
  email      String   @unique
  name       String?
  role       Role     @default(VIEWER) // Admin, Manager, or Viewer
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  store String @unique
  orders     Order[]  @relation("UserOrders")

  Log Log[]
}

model Order {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  userId        String         @db.ObjectId
  user          User           @relation("UserOrders", fields: [userId], references: [id])
  status        OrderStatus    @default(PENDING) // PENDING, CONFIRMED, EDITED, CANCELED
  products      OrderProduct[]
  totalAmount   Float
  currency      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  Log Log[]
}


model Product {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  shopifyId    String   @unique // Shopify Product ID
  title        String
  description  String?
  price        Float
  currency     String
  orders       OrderProduct[]
}

model OrderProduct {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String   @db.ObjectId
  order      Order    @relation(fields: [orderId], references: [id])
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
}


model Log {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  orderId    String   @db.ObjectId
  order      Order    @relation(fields: [orderId], references: [id])
  action     LogAction // CONFIRM, EDIT, CANCEL
  message    String?
  createdAt  DateTime @default(now())
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  EDITED
  CANCELED
}

enum LogAction {
  CONFIRM
  EDIT
  CANCEL
}
